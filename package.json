{
  "name": "ctf-nexus-challenge",
  "version": "1.0.0",
  "description": "CTF Challenge — SQL Injection & XSS Exploitation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
