<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEXUS — Secure Authentication Portal</title>
  <meta name="description" content="NEXUS Secure Operations Terminal — Authentication Required">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔐</text></svg>">
</head>
<body>
  <canvas id="matrix-canvas"></canvas>

  <div class="page-wrapper">
    <div class="login-page">
      <div class="login-container">
        <div class="login-card">

          <!-- Login Header -->
          <div class="login-header">
            <div class="login-icon">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                <circle cx="12" cy="16" r="1"/>
              </svg>
            </div>
            <h2 class="glitch" data-text="AUTHENTICATION">AUTHENTICATION</h2>
            <p>Enter credentials to access the Nexus network</p>
          </div>

          <!-- Alert Messages -->
          <% if (error) { %>
            <div class="alert alert-error">
              ⚠ <%- error %>
            </div>
          <% } %>
          <% if (success) { %>
            <div class="alert alert-success">
              ✓ <%= success %>
            </div>
          <% } %>

          <!-- Login Form -->
          <form action="/login" method="POST" autocomplete="off">
            <div class="form-group">
              <label for="username">
                Operator ID <span class="required">*</span>
              </label>
              <input
                type="text"
                id="username"
                name="username"
                class="form-input"
                placeholder="Enter your operator ID"
                required
                autofocus
              >
            </div>

            <div class="form-group">
              <label for="password">
                Access Key <span class="required">*</span>
              </label>
              <input
                type="password"
                id="password"
                name="password"
                class="form-input"
                placeholder="Enter your access key"
                required
              >
            </div>

            <div class="form-group">
              <label for="access_code">
                Clearance Code
              </label>
              <input
                type="text"
                id="access_code"
                name="access_code"
                class="form-input"
                placeholder="Optional — Level 3+ clearance"
              >
            </div>

            <button type="submit" class="btn-submit">
              ▶ AUTHENTICATE
            </button>
          </form>

          <!-- Footer -->
          <div class="login-footer">
            <p>NEXUS SECURE NETWORK — ALL ACCESS MONITORED</p>
            <div class="security-badge">
              🔒 AES-256 ENCRYPTED SESSION • TLS 1.3
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
