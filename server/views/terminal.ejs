<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEXUS — Command Terminal</title>
  <meta name="description" content="NEXUS Operations Command Terminal">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💻</text></svg>">
</head>
<body>
  <canvas id="matrix-canvas"></canvas>

  <div class="page-wrapper">
    <%- include('partials/header', { user: user }) %>

    <main class="terminal-page">
      <div class="container">

        <h1 class="dashboard-title" style="margin-bottom: 24px;">
          Command <span>Terminal</span>
        </h1>

        <!-- Message Alert -->
        <% if (message) { %>
          <div class="alert alert-error" style="margin-bottom: 20px;">
            <%- message %>
          </div>
        <% } %>

        <!-- Terminal Window -->
        <div class="terminal-window">

          <!-- Title Bar -->
          <div class="terminal-titlebar">
            <div class="terminal-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="terminal-title">
              nexus@ops:~ — COMMAND INTERFACE — PID:<%= process.pid %>
            </span>
          </div>

          <!-- Input Area -->
          <div class="terminal-input-area">
            <form action="/terminal" method="POST" class="terminal-form">
              <span class="terminal-prompt"><%= user.username %>@nexus:~$</span>
              <input
                type="text"
                id="cmd-input"
                name="command"
                class="terminal-cmd-input"
                placeholder="Type a command or message..."
                autocomplete="off"
                autofocus
              >
              <button type="submit" class="terminal-send-btn">Execute</button>
            </form>
          </div>

          <!-- Early XSS Interceptor — MUST load before terminal output renders -->
          <script>
            (function() {
              var flagRevealed = false;
              function earlyFlagReveal() {
                if (flagRevealed) return;
                flagRevealed = true;
                window.__xssDetected = true;
                fetch('/api/flag')
                  .then(function(r) { return r.json(); })
                  .then(function(data) {
                    // Build and show the flag modal
                    var overlay = document.createElement('div');
                    overlay.className = 'flag-overlay active';
                    overlay.innerHTML =
                      '<div class="flag-modal">' +
                        '<div class="flag-modal-header">' +
                          '<h2>\uD83C\uDFF4 FLAG CAPTURED \uD83C\uDFF4</h2>' +
                          '<p>' + (data.message || 'XSS vulnerability exploited!') + '</p>' +
                        '</div>' +
                        '<div class="flag-content" style="white-space:pre-wrap;max-height:400px;overflow:auto;">' +
                          data.flag_content.replace(/</g,'&lt;').replace(/>/g,'&gt;') +
                        '</div>' +
                        '<button class="flag-close-btn" onclick="this.closest(\'.flag-overlay\').remove()">DISMISS</button>' +
                      '</div>';
                    document.body.appendChild(overlay);
                    overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.remove(); });
                  })
                  .catch(function(err) { console.error('[NEXUS] Flag fetch failed:', err); });
              }
              // Override alert/prompt/confirm BEFORE any injected scripts execute
              var _alert = window.alert;
              var _prompt = window.prompt;
              var _confirm = window.confirm;
              window.alert = function(m) { earlyFlagReveal(); return _alert.call(window, m); };
              window.prompt = function(m, d) { earlyFlagReveal(); return _prompt.call(window, m, d); };
              window.confirm = function(m) { earlyFlagReveal(); return _confirm.call(window, m); };
            })();
          </script>

          <!-- Output / Logs -->
          <div class="terminal-output">
            <% if (logs.length === 0) { %>
              <div class="log-entry">
                <span class="log-command" style="color: var(--text-dim);">
                  [No commands logged yet. Type something above to begin.]
                </span>
              </div>
            <% } else { %>
              <% logs.forEach(function(log) { %>
                <div class="log-entry">
                  <span class="log-timestamp">
                    <%= new Date(log.timestamp).toLocaleTimeString('en-US', { hour12: false }) %>
                  </span>
                  <span class="log-user"><%= log.username %></span>
                  <!-- ════════════════════════════════════════════════ -->
                  <!-- ⚠️  INTENTIONALLY VULNERABLE TO XSS            -->
                  <!-- Raw output (<%- %>) — NO sanitization!         -->
                  <!-- This is the CTF challenge injection point!     -->
                  <!-- ════════════════════════════════════════════════ -->
                  <span class="log-command"><%- log.command %></span>
                  <span class="log-ip"><%= log.ip_address || '—' %></span>
                </div>
              <% }); %>
            <% } %>
          </div>

          <!-- Info Bar -->
          <div class="terminal-info">
            <span>Entries: <%= logs.length %> / 50 max</span>
            <span class="status-online">● LIVE</span>
            <span>Worker: PID-<%= process.pid %></span>
          </div>

        </div>

        <!-- Tips Section -->
        <div class="terminal-tips" style="margin-top: 24px;">
          <h3>⚡ Terminal Reference</h3>
          <ul class="tip-list">
            <li>All commands are logged and visible to all operators in real-time</li>
            <li>The terminal accepts any input — no restrictions are currently enforced</li>
            <li>System commands, network queries, and diagnostics are all supported</li>
            <li>Logs persist across sessions and are shared between all connected operators</li>
            <li>HTML content may be rendered inline for rich output formatting</li>
            <li>Report anomalies to the security team via the dashboard</li>
          </ul>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
